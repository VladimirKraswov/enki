{
  "name": "enki-agent-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "Enki Runtime: host-local execution service embedding the Pi coding agent SDK",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node build.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts test/integration",
    "test:node": "node test/run-node-suites.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@earendil-works/chord": "0.85.1",
    "@earendil-works/pi-telemetry": "0.85.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "node-pty": "1.1.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.25.10",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@earendil-works/chord": "0.85.1",
    "@earendil-works/pi-telemetry": "0.85.1"
  }
}
