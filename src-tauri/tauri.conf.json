{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enki",
  "mainBinaryName": "enki",
  "version": "0.2.115",
  "identifier": "dev.local.opencodedesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Enki",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob:",
        "font-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:* http://localhost:* http://[::1]:* ws://127.0.0.1:* ws://localhost:* ws://[::1]:*",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop workspace for OpenCode and Pi",
    "longDescription": "Native desktop workspace for independently installed OpenCode and Pi agents: projects, sessions, streaming tool output, permissions, PTY and model selection. The engine is installed and updated independently of this application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "replaces": [
          "arvela"
        ],
        "conflicts": [
          "arvela"
        ],
        "provides": [
          "arvela"
        ]
      },
      "rpm": {
        "obsoletes": [
          "arvela"
        ],
        "provides": [
          "arvela"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzODlCRDBDN0ZDNzUxRApSV1FkZGZ6SDBKczRER2phZnBKWi9mWmdYWmd4c3RwaFoycnlvRHV4Q2lGclBuaEtoZHhJSHlwLwo=",
      "requireSignedVersion": true
    }
  }
}
